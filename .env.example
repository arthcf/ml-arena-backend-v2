# DOCKER
DB_CONTAINER_NAME=
API_CONTAINER_NAME=
WORKER_CONTAINER_NAME=
REDIS_CONTAINER_NAME=
RABBITMQ_CONTAINER_NAME=
MINIO_CONTAINER_NAME=
# Desenvolvimento: descomente para o compose também ler compose.dev.yaml (publica banco,
# Redis e AMQP em 127.0.0.1). Deixe comentado para rodar como na entrega.
# COMPOSE_FILE=docker-compose.yaml:compose.dev.yaml

# DATABASE (também criam o usuário e o banco no container Postgres)
DB_HOST=
DB_PORT=
DB_EXTERNAL_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# AUTH
SECRET_KEY=

# CACHE (no compose: redis://redis:6379/0)
REDIS_URL=

# MINIO (credenciais do usuário raiz; a senha precisa de pelo menos 8 caracteres)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=ml-arena
# Endereço na rede do compose (API e worker) e endereço que o navegador alcança (links)
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000

# RABBITMQ (o compose as passa como RABBITMQ_DEFAULT_USER/PASS; painel em :15672)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# AWS: só o DynamoDB (auditoria) continua na AWS
AWS_REGION=
DYNAMODB_AUDIT_TABLE=ml-arena-audit

# AWS: credenciais do Learner Lab (expiram a cada sessão)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
